# Backend / Supabase Postgres connection
# Get these from Supabase → Project Settings → Database → Connection string (URI, "Session pooler" or direct)
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase project (only used if/when frontend talks to Supabase directly for anything; backend does NOT use Supabase Auth)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# QR token signing (separate secret from JWT)
QR_SIGNING_SECRET=change-me-to-another-long-random-string
QR_TOKEN_TTL_SECONDS=5

# Cooldown
COOLDOWN_MINUTES=60

# Professor self-registration gate. Backend-only — never exposed via any API response,
# never logged, never put in a NEXT_PUBLIC_* var. Leave unset/empty to disable public
# professor registration entirely (recommended once real professors are onboarded via
# the admin interface instead).
PROFESSOR_INVITE_CODE=change-me-to-a-long-random-string

# CORS (comma-separated list of allowed origins, no trailing slashes)
CORS_ORIGINS=http://localhost:3000,https://proxy-buster.vercel.app

# Frontend (Next.js) — copy relevant vars into frontend/.env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
